RECORDER_TOKEN=REPLACE_WITH_A_RANDOM_URLSAFE_TOKEN
RECORDER_DATA=/var/lib/recorder
RECORDER_BIND=127.0.0.1
RECORDER_PORT=8080
RECORDER_QUOTA_BYTES=10737418240
# Optional, separate encrypted transcript/summary capacity (256 MiB):
RECORDER_TEXT_QUOTA_BYTES=268435456
# Optional server-side retention for audio and text ciphertext objects; 0 keeps them indefinitely:
RECORDER_RETENTION_DAYS=0
